# Den alten Admin-Bereich (/admin/...) gibt es nicht mehr. Er ist jetzt Teil der Karte.
# Alte Links und Lesezeichen leiten auf die neuen Adressen weiter.
# (build.sh kopiert diese Datei nach dist/admin/, Angular kopiert keine versteckten Dateien.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^place/new/?$ /ort/neu [R=301,L]
  RewriteRule ^place/([0-9]+)/?$ /ort/$1 [R=301,L]
  RewriteRule ^profile/?$ /profil [R=301,L]
  RewriteRule ^categories/?$ /kategorien [R=301,L]
  RewriteRule ^ /meine-orte [R=301,L]
</IfModule>
