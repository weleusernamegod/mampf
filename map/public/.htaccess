# Apache-Einstellungen für mampf.io (liegt im Webroot, gilt auch für /admin und /login)

# Die HTML-Seiten (index.html usw.) nie ungeprüft aus dem Cache nehmen.
# So bekommen alle Besucher nach einem Upload sofort die neue Version.
# Die JS/CSS-Dateien haben eindeutige Namen (main-XYZ.js) und dürfen gecacht werden.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Unterseiten der Karte (z.B. /meine-orte) gibt es nur in der Angular-App.
# Alles, was keine echte Datei ist, geht an index.html (auch Neuladen und direkte Links).
# /api, /admin, /login und /bilder sind ausgenommen (eigene Regeln bzw. echte 404).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(api|admin|login|bilder)(/|$) - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Web-App-Manifest (Name und Icon für den Home-Bildschirm) mit richtigem Typ ausliefern
AddType application/manifest+json .webmanifest
